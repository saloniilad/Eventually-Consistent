# HTTP / WebSocket port
PORT=4000
# Leave DATABASE_URL empty to run with the in-memory store (data is lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventually_consistent
# REQUIRED in production. Use a long random string.
JWT_SECRET=change-me-in-production
# Comma separated list of allowed browser origins (or * for any)
CORS_ORIGIN=http://localhost:5173
# Write a snapshot after this many new operations (and when the last client leaves)
SNAPSHOT_EVERY=200
# Hard cap on visible characters per document
MAX_DOC_CHARS=500000
LOG_LEVEL=info
